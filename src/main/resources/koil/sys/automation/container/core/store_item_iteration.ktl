version: 2
kind: task_template
id: template.container_core_store_item_iteration
template_id: container/core/store_item_iteration
semantic_operation: sem.task.store_item_in_container
params: [item.id, count.value, state.counter]
metadata:
  semantic_operations: [sem.task.store_item_in_container]
  target_kinds: [block]
  required_params: [item.id]
  optional_params: [count.value, state.counter]
  tags: [container, store, iteration]
  description: Store Item Iteration
  visibility: internal
  model_callable: false
  resource_locks: [movement, look, input, screen, inventory]
  side_effects: [changes_inventory, uses_screen]
  timeout_ticks: 2400
  failure_policy: fail
steps:
  - type: run_primitive
    action: cap.container.find_item_in_open_screen
    params:
      item.id: ${item.id}
      player.only: true
      result.key: result.container.slot
  - type: run_primitive
    action: cap.container.quick_move_slot
    params:
      slot.index: ${result.container.slot}
      item.id: ${item.id}
      expected.count: ${count.value}
      state.counter: ${state.counter}
      transfer.direction: store
  - type: run_primitive
    action: cap.state.increment_counter
    params:
      state.key: state.counter
      delta: ${result.transfer.moved_count}
  - type: goto
    scope: parent
    goto: need_more_items
  - type: return
    label: done

