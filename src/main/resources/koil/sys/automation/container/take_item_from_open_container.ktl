version: 2
kind: task_template
id: template.goal_container_take_item_from_open_container
template_id: goal/container/take_item_from_open_container
semantic_operation: sem.task.take_item_from_container
params: [item.id, count.value, state.counter]
metadata:
  semantic_operations: [sem.task.take_item_from_container]
  target_kinds: [block]
  required_params: [item.id]
  optional_params: [count.value, state.counter]
  tags: [goal, container, take, inventory, transaction]
  description: Withdraw a measured item count from the currently open synchronized storage container for goal execution
  visibility: internal
  model_callable: false
  resource_locks: [screen, cursor, inventory]
  side_effects: [changes_inventory, uses_screen]
  timeout_ticks: 1200
  failure_policy: fail
steps:
  - type: delegate
    delegate: container/core/take_item_from_open_container.ktl item.id=${item.id} count.value=${count.value} state.counter=${state.counter}
  - type: delegate
    delegate: flow/core/close_screen.ktl
  - type: return
    label: acquired
