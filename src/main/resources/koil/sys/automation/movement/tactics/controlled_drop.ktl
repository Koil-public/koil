version: 2
kind: task_template
id: template.movement_tactics_controlled_drop
template_id: movement/tactics/controlled_drop
semantic_operation: sem.task.move_to_target
params: [stop.distance]
metadata:
  semantic_operations: [sem.task.move_to_target]
  target_kinds: [location]
  required_params: []
  optional_params: [stop.distance]
  tags: [movement, tactic, drop]
  description: Controlled Drop
  visibility: internal
  model_callable: false
  resource_locks: [movement, look, input]
  side_effects: [moves_player, changes_orientation]
  timeout_ticks: 3600
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: run_primitive
    action: cap.movement.set_sneak
    params:
      pressed: true
  - type: run_primitive
    action: cap.path.move_to_target
    params:
      stop.distance: ${stop.distance}
      path.use_y: true
      movement.allow_sprint: false
  - type: run_primitive
    action: cap.movement.set_sneak
    params:
      pressed: false
  - type: return
    label: done
