version: 2
kind: task_template
id: template.movement_tactics_jump_up
template_id: movement/tactics/jump_up
semantic_operation: sem.task.jump_once
params: [stop.distance]
metadata:
  semantic_operations: [sem.task.jump_once]
  target_kinds: [location]
  required_params: []
  optional_params: [stop.distance]
  tags: [movement, tactic, jump]
  description: Jump Up
  visibility: internal
  model_callable: false
  resource_locks: [movement, look, input]
  side_effects: [moves_player, changes_orientation]
  timeout_ticks: 3600
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: run_primitive
    action: cap.movement.timed_jump
    params:
      ticks: 5
  - type: run_primitive
    action: cap.path.move_to_target
    params:
      stop.distance: ${stop.distance}
      path.use_y: true
  - type: return
    label: done
