version: 2
kind: task_template
id: template.goals_core_follow_target
template_id: goals/core/follow_target
semantic_operation: sem.goal.follow
params: [target.id, target.kind, target.selector, radius, stop.distance]
metadata:
  semantic_operations: [sem.goal.follow]
  target_kinds: [entity, player]
  required_params: [target.id]
  optional_params: [target.kind, target.selector, radius, stop.distance]
  tags: [goal, movement, follow]
  description: Resolve and continuously follow a live target
  visibility: public
  model_callable: true
  resource_locks: [movement, look, input, world]
  side_effects: [moves_player, changes_orientation]
  timeout_ticks: 6000
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: delegate
    delegate: movement/follow/follow_entity.ktl target.id=${target.id} target.kind=${target.kind} target.selector=${target.selector} radius=${radius} stop.distance=${stop.distance}
  - type: return
    label: done
