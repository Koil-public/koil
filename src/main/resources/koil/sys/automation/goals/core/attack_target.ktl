version: 2
kind: task_template
id: template.goals_core_attack_target
template_id: goals/core/attack_target
semantic_operation: sem.goal.attack
params: [target.id, target.kind, target.selector, radius, stop.distance, attack.range]
metadata:
  semantic_operations: [sem.goal.attack]
  target_kinds: [entity, player]
  required_params: [target.id]
  optional_params: [target.kind, target.selector, radius, stop.distance, attack.range]
  tags: [goal, combat, attack]
  description: Resolve, pursue, and attack a target until death
  visibility: public
  model_callable: true
  resource_locks: [movement, look, input, combat, world]
  side_effects: [moves_player, changes_orientation, attacks_entity]
  timeout_ticks: 6000
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: delegate
    delegate: combat/core/attack_entity_until_dead.ktl target.id=${target.id} target.kind=${target.kind} target.selector=${target.selector} radius=${radius} stop.distance=${stop.distance} attack.range=${attack.range}
  - type: return
    label: done
