version: 2
kind: semantic_operation_pack
id: semantics.interaction
operations:
  - id: sem.interaction.use_item_on_block
    intent: use_item_on_block
    target_kinds: [block]
    preferred_templates: [interaction/core/use_item_on_block]

  - id: sem.interaction.interact_entity
    intent: interact_entity
