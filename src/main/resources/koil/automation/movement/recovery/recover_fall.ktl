version: 2
kind: task_template
id: template.movement_recovery_recover_fall
template_id: movement/recovery/recover_fall
semantic_operation: sem.task.move_to_target
params: []
metadata:
  semantic_operations: [sem.task.move_to_target]
  target_kinds: [location]
  required_params: []
  optional_params: []
  tags: [movement, recovery, fall]
  description: Recover Fall
  visibility: internal
  model_callable: false
  resource_locks: [movement, look, input]
  side_effects: [moves_player, changes_orientation]
  timeout_ticks: 3600
  failure_policy: fail
steps:
  - type: run_primitive
    action: cap.movement.run_recovery
    params:
      recovery.tactic: wait_for_ground
  - type: return
    label: done
