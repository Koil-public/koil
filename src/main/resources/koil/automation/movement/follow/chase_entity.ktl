version: 2
kind: task_template
id: template.movement_follow_chase_entity
template_id: movement/follow/chase_entity
semantic_operation: sem.task.follow_target
params: [stop.distance]
metadata:
  semantic_operations: [sem.task.follow_target]
  target_kinds: [entity, player, item]
  required_params: []
  optional_params: [stop.distance]
  tags: [movement, follow]
  description: Chase Entity
  visibility: public
  model_callable: true
  resource_locks: [movement, look, input]
  side_effects: [moves_player, changes_orientation]
  timeout_ticks: 3600
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: run_primitive
    action: cap.path.follow_target
    params:
      stop.distance: ${stop.distance}
      sprint: true
  - type: return
    label: done
