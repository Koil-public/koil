version: 2
kind: task_template
id: template.movement_tactics_swim_to
template_id: movement/tactics/swim_to
semantic_operation: sem.task.swim
params: [stop.distance]
metadata:
  semantic_operations: [sem.task.swim]
  target_kinds: [location]
  required_params: []
  optional_params: [stop.distance]
  tags: [movement, tactic, swim]
  description: Swim To
  visibility: internal
  model_callable: false
  resource_locks: [movement, look, input]
  side_effects: [moves_player, changes_orientation]
  timeout_ticks: 3600
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: run_primitive
    action: cap.path.move_to_target
    params:
      stop.distance: ${stop.distance}
      movement.allow_swim: true
      path.use_y: true
  - type: return
    label: done
