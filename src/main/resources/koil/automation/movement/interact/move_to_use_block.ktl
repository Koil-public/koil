version: 2
kind: task_template
id: template.movement_interact_move_to_use_block
template_id: movement/interact/move_to_use_block
semantic_operation: sem.task.interact_target
params: [target.id, target.selector, radius, stop.distance, hand.id, interaction.sneak]
metadata:
  semantic_operations: [sem.task.interact_target]
  target_kinds: [block]
  required_params: [target.id]
  optional_params: [target.selector, radius, stop.distance, hand.id, interaction.sneak]
  tags: [movement, interact]
  description: Move To Use Block
  visibility: public
  model_callable: true
  resource_locks: [movement, look, input]
  side_effects: [moves_player, changes_orientation]
  timeout_ticks: 3600
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: delegate
    delegate: movement/navigation/move_to_interactable.ktl target.id=${target.id} target.selector=${target.selector} radius=${radius} stop.distance=${stop.distance}
  - type: run_primitive
    action: cap.interaction.use_item_on_current_block
    params:
      hand.id: ${hand.id}
      interaction.sneak: ${interaction.sneak}
  - type: return
    label: done
