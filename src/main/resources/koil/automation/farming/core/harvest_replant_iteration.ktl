version: 2
kind: task_template
id: template.farming_core_harvest_replant_iteration
template_id: farming/core/harvest_replant_iteration
semantic_operation: sem.farming.harvest_replant
params: [target.id, item.id, count.value, state.counter, radius, stop.distance, hand.id]
metadata:
  semantic_operations: [sem.farming.harvest_replant]
  target_kinds: [block, item]
  required_params: [target.id, item.id]
  optional_params: [count.value, state.counter, radius, stop.distance, hand.id]
  tags: [farming, harvest, replant, iteration, internal]
  description: One validated harvest and replant iteration
  visibility: internal
  model_callable: false
  resource_locks: [movement, look, input, inventory, world]
  side_effects: [moves_player, changes_orientation, changes_world_blocks, changes_inventory]
  timeout_ticks: 6000
  failure_policy: fail
steps:
  - type: delegate
    delegate: inventory/core/require_item.ktl item.id=${item.id} count.value=1 condition.op=gte
  - type: delegate
    delegate: movement/navigation/move_to_block.ktl target.id=${target.id} target.selector=nearest radius=${radius} stop.distance=${stop.distance}
  - type: run_primitive
    action: cap.look.face_block_face
    params: {}
  - type: run_primitive
    action: cap.interaction.break_block_target
    params: {}
  - type: run_primitive
    action: cap.inventory.select_hotbar_item
    params:
      item.id: ${item.id}
  - type: run_primitive
    action: cap.interaction.use_item_on_current_block
    params:
      hand.id: ${hand.id}
  - type: run_primitive
    action: cap.state.increment_counter
    params:
      state.key: state.counter
      delta: 1
  - type: delegate
    delegate: farming/core/harvest_and_replant.ktl target.id=${target.id} item.id=${item.id} count.value=${count.value} state.counter=${state.counter} radius=${radius} stop.distance=${stop.distance} hand.id=${hand.id}
  - type: return
    label: done
