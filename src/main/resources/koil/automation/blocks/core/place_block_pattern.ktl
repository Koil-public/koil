version: 2
kind: task_template
id: template.blocks_core_place_block_pattern
template_id: blocks/core/place_block_pattern
semantic_operation: sem.task.place_item_on_target
params: [block.id, item.id, pattern.id, pattern.length, pattern.width, count.value, state.counter, direction.id, hand.id]
metadata:
  semantic_operations: [sem.task.place_item_on_target]
  target_kinds: [block, location]
  required_params: [block.id, item.id, pattern.id, pattern.length, pattern.width, count.value]
  optional_params: [state.counter, direction.id, hand.id]
  tags: [block, place, build, pattern]
  description: Place a verified line, perimeter, or platform
  visibility: public
  model_callable: true
  resource_locks: [movement, look, input, world]
  side_effects: [moves_player, changes_world_blocks, changes_inventory]
  timeout_ticks: 24000
  failure_policy: fail
steps:
  - type: branch
    label: need_more_blocks
    condition: counter_lt_target
    then_input: blocks/core/place_block_pattern_iteration.ktl block.id=${block.id} item.id=${item.id} pattern.id=${pattern.id} pattern.length=${pattern.length} pattern.width=${pattern.width} count.value=${count.value} state.counter=${state.counter} direction.id=${direction.id} hand.id=${hand.id}
  - type: return
    label: done
