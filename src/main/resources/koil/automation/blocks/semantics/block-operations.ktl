version: 2
kind: semantic_operation_pack
id: semantics.blocks
operations:
  - id: sem.task.mine_block_count
    intent: mine
    target_kinds: [block]
    preferred_templates: [blocks/core/mine_block_until_count]

  - id: sem.task.mine_block_collection
    intent: mine_all
    target_kinds: [block]
    preferred_templates: [blocks/core/mine_all_matching]

  - id: sem.task.place_item_on_target
    intent: place
    target_kinds: [block]
    preferred_templates: [blocks/core/place_item_on_block_target]

  - id: sem.task.place_block_pattern
    intent: build_pattern
    target_kinds: [block, location]
    preferred_templates: [blocks/core/place_block_pattern]
