version: 2
kind: task_template
id: template.interaction_core_use_item_on_block
template_id: interaction/core/use_item_on_block
semantic_operation: sem.interaction.use_item_on_block
params: [item.id, target.id, target.selector, hand.id, radius, stop.distance]
metadata:
  semantic_operations: [sem.interaction.use_item_on_block]
  target_kinds: [block]
  required_params: [item.id, target.id]
  optional_params: [target.selector, hand.id, radius, stop.distance]
  tags: [interaction, item, block]
  description: Select an item, approach a block, face it, and use the item
  visibility: public
  model_callable: true
  resource_locks: [movement, look, input, inventory, world]
  side_effects: [moves_player, changes_orientation, uses_item, changes_world_blocks]
  timeout_ticks: 6000
  failure_policy: recover
  recovery_task: movement/recovery/recover_stuck.ktl
steps:
  - type: delegate
    delegate: inventory/core/require_item.ktl item.id=${item.id} count.value=1 condition.op=gte
  - type: run_primitive
    action: cap.inventory.select_hotbar_item
    params:
      item.id: ${item.id}
  - type: delegate
    delegate: movement/navigation/move_to_block.ktl target.id=${target.id} target.selector=${target.selector} radius=${radius} stop.distance=${stop.distance}
  - type: run_primitive
    action: cap.look.face_block_face
    params: {}
  - type: run_primitive
    action: cap.interaction.use_item_on_block_target
    params:
      hand.id: ${hand.id}
  - type: return
    label: done
