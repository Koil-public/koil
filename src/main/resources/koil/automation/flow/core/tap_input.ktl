version: 2
kind: task_template
id: template.flow_core_tap_input
template_id: flow/core/tap_input
semantic_operation: sem.task.click_input
params: [input.key, count.value]
metadata:
  semantic_operations: [sem.task.click_input]
  target_kinds: []
  required_params: [input.key]
  optional_params: [count.value]
  tags: [flow, input]
  description: Tap Input
  visibility: internal
  model_callable: false
  resource_locks: [input, screen]
  side_effects: [changes_input_or_screen]
  timeout_ticks: 600
  failure_policy: fail
steps:
  - type: run_primitive
    action: cap.input.tap_key
    params:
      input.key: ${input.key}
      count.value: ${count.value}
  - type: return
    label: done

