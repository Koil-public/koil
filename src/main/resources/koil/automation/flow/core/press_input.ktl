version: 2
kind: task_template
id: template.flow_core_press_input
template_id: flow/core/press_input
semantic_operation: sem.task.press_input
params: [input.key]
metadata:
  semantic_operations: [sem.task.press_input]
  target_kinds: []
  required_params: [input.key]
  optional_params: []
  tags: [flow, input]
  description: Press Input
  visibility: internal
  model_callable: false
  resource_locks: [input, screen]
  side_effects: [changes_input_or_screen]
  timeout_ticks: 600
  failure_policy: fail
steps:
  - type: run_primitive
    action: cap.input.press_key
    params:
      input.key: ${input.key}
  - type: return
    label: done

